PORT=3000
DATABASE_URL=
PUBLIC_BASE_URL=
SESSION_SECRET=
PANEL_RECOVERY_TOKEN=

# Trust Railway/known reverse-proxy forwarding headers. Disable for direct local exposure.
TRUST_PROXY=true
MAX_JSON_BODY_BYTES=1048576
MAX_WEBSOCKET_FRAME_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=25000
DNS_SERVER=8.8.4.4
DNS_PORT=53

# Map saved Cloudflare edge ports to Railway's public HTTP ports (443/80) in generated links.
RAILWAY_EDGE_PORT_MAPPING=1

# Optional Railway deployment controls used by the existing panel buttons.
RAILWAY_TOKEN=
RAILWAY_TOKEN_TYPE=account
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_DEPLOYMENT_ID=
RAILWAY_API_URL=https://backboard.railway.com/graphql/v2

# Optional GitHub configuration. Railway GitHub autodeploy remains the preferred update path.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_WORKFLOW_ID=

# Optional legacy Cloudflare integrations. Core Railway ZEUS does not require these.
CF_API_TOKEN=
CF_ACCOUNT_ID=
WORKER_NAME=
